{
  "name": "@sudobility/shapeshyft_service",
  "version": "1.0.14",
  "description": "Shared tables, routes and middleware for ShapeShyft-style structured-output APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "dependencies": {
    "@hono/zod-validator": "~0.7.6",
    "@sudobility/shapeshyft_engine": "^1.0.13",
    "resend": "~6.28.0",
    "zod": "~3.25.76"
  },
  "peerDependencies": {
    "@sudobility/auth_service": "^1.1.30",
    "@sudobility/entity_service": "^1.0.50",
    "@sudobility/ratelimit_service": "^1.0.48",
    "@sudobility/subscription_service": "^1.0.32",
    "@sudobility/types": "^1.9.76",
    "drizzle-orm": "^0.45.0",
    "firebase-admin": "^13.6.0",
    "hono": "^4.10.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "~0.39.0",
    "@google/generative-ai": "~0.21.0",
    "@sudobility/auth_service": "^1.1.30",
    "@sudobility/entity_service": "^1.0.50",
    "@sudobility/ratelimit_service": "^1.0.48",
    "@sudobility/subscription_service": "^1.0.32",
    "@sudobility/test-db-guard": "^1.0.3",
    "@sudobility/types": "^1.9.76",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-orm": "~0.45.4",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "firebase-admin": "~13.10.0",
    "groq-sdk": "~0.37.0",
    "hono": "~4.11.5",
    "openai": "~4.104.0",
    "postgres": "~3.4.9",
    "prettier": "~3.9.10",
    "sharp": "~0.35.4",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/shapeshyft_service.git"
  }
}
